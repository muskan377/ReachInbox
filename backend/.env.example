NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
# Local Windows services: PostgreSQL, Memurai (Redis-compatible), Elasticsearch
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/reachinbox?schema=public"
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
SESSION_SECRET=replace-with-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# Optional Slack app OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/slack/callback
# Worker + throttling
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Ethereal: leave blank to create a disposable test SMTP account automatically
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=ReachInbox Demo
